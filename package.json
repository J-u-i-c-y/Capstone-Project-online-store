{
  "name": "project-template",
  "version": "1.0.0",
  "description": "Capstone Project Template ",
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/campus_javascript/capstone-project/project-template.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"sass --watch src/scss:dist/css\" \"tsc --watch\" \"live-server . --port=7000 --host=localhost --open=/src/index.html\"",
    "sass": "sass src/scss:dist/css",
    "compile": "tsc",
    "build": "npm run sass && npm run compile",
    "lint": "eslint \"src/**/*.ts\" && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix && stylelint \"src/**/*.scss\" --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "live-server": "^1.2.2",
    "sass": "^1.107.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
